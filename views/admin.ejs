<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <title>Panel Owner / Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
  <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <span class="font-bold text-lg text-purple-400">Panel Kawalan Owner</span>
      <a href="/dashboard" class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1 rounded-md text-white transition">Kembali ke Dashboard</a>
    </div>
    <a href="/logout" class="text-xs bg-red-600/80 hover:bg-red-500 px-3 py-1.5 rounded-md transition">Log Keluar</a>
  </nav>

  <div class="max-w-6xl mx-auto p-6 space-y-8">
    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500 text-red-400 p-4 rounded-xl text-sm"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="bg-green-500/10 border border-green-500 text-green-400 p-4 rounded-xl text-sm"><%= success %></div>
    <% } %>

    <!-- Bahagian Tambah Domain Induk -->
    <div class="bg-slate-800 rounded-2xl border border-slate-700 p-6">
      <h2 class="text-lg font-bold text-blue-400 mb-2">Tambah Domain Induk Baru</h2>
      <p class="text-xs text-slate-400 mb-4">Domain ini mestilah aktif di akaun Cloudflare anda.</p>

      <form action="/admin/domain/add" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Nama Domain</label>
          <input type="text" name="domain_name" placeholder="fakrulafif.store" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Cloudflare Zone ID</label>
          <input type="text" name="cf_zone_id" placeholder="32 karakter Zone ID" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Cloudflare API Token</label>
          <input type="password" name="cf_api_token" placeholder="API Token Cloudflare (Edit DNS)" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div class="md:col-span-3">
          <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition">Simpan Domain</button>
        </div>
      </form>

      <!-- Senarai Domain -->
      <div class="mt-6">
        <h3 class="text-xs font-bold uppercase text-slate-400 mb-2">Senarai Domain Sedia Ada</h3>
        <div class="divide-y divide-slate-700">
          <% domains.forEach(d => { %>
            <div class="py-2.5 flex justify-between items-center text-sm">
              <span class="font-semibold text-white"><%= d.domain_name %></span>
              <form action="/admin/domain/delete/<%= d.id %>" method="POST" onsubmit="return confirm('Padam domain ini?');">
                <button class="text-xs bg-red-600/80 hover:bg-red-500 text-white px-3 py-1 rounded transition">Padam</button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Bahagian Urus Pengguna & Pakej -->
    <div class="bg-slate-800 rounded-2xl border border-slate-700 p-6">
      <h2 class="text-lg font-bold text-purple-400 mb-4">Pengurusan Pengguna & Pakej</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-900/50 text-slate-400 uppercase text-xs">
            <tr>
              <th class="p-3">Emel</th>
              <th class="p-3">Role</th>
              <th class="p-3">Pakej</th>
              <th class="p-3 text-right">Kemaskini</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700">
            <% users.forEach(u => { %>
              <tr>
                <td class="p-3 font-semibold text-white"><%= u.email %></td>
                <form action="/admin/user/update-package" method="POST">
                  <input type="hidden" name="user_id" value="<%= u.id %>">
                  <td class="p-3">
                    <select name="role" class="bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-slate-200">
                      <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                      <option value="owner" <%= u.role === 'owner' ? 'selected' : '' %>>Owner</option>
                    </select>
                  </td>
                  <td class="p-3">
                    <select name="package_name" class="bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-slate-200">
                      <option value="biasa" <%= u.package === 'biasa' ? 'selected' : '' %>>Biasa (Had 3)</option>
                      <option value="prem" <%= u.package === 'prem' ? 'selected' : '' %>>Prem (Had 6)</option>
                      <option value="vip" <%= u.package === 'vip' ? 'selected' : '' %>>VIP (Had 10)</option>
                    </select>
                  </td>
                  <td class="p-3 text-right">
                    <button type="submit" class="text-xs bg-purple-600 hover:bg-purple-500 text-white px-3 py-1 rounded transition">Simpan</button>
                  </td>
                </form>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>

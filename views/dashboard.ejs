<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <title>Dashboard Pengguna</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
  <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <span class="font-bold text-lg text-blue-400">DNS Manager</span>
      <span class="text-xs px-2.5 py-1 bg-blue-500/20 text-blue-300 rounded-full font-semibold uppercase tracking-wider">
        Pakej: <%= user.package %>
      </span>
      <% if (user.role === 'owner') { %>
        <a href="/admin" class="text-xs bg-purple-600 hover:bg-purple-500 px-3 py-1 rounded-md font-bold text-white transition">Panel Owner</a>
      <% } %>
    </div>
    <div class="flex items-center space-x-4">
      <span class="text-sm text-slate-400"><%= user.email %></span>
      <a href="/logout" class="text-xs bg-red-600/80 hover:bg-red-500 px-3 py-1.5 rounded-md transition">Log Keluar</a>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto p-6 space-y-8">
    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500 text-red-400 p-4 rounded-xl text-sm"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="bg-green-500/10 border border-green-500 text-green-400 p-4 rounded-xl text-sm"><%= success %></div>
    <% } %>

    <!-- Ringkasan Kuota -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700">
        <div class="text-xs text-slate-400 font-semibold uppercase">Subdomain Utama Dimiliki</div>
        <div class="text-2xl font-bold mt-1 text-white"><%= primarySubdomains.length %> / <%= limit %></div>
      </div>
      <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700">
        <div class="text-xs text-slate-400 font-semibold uppercase">Subdomain Sekunder (Level 2)</div>
        <div class="text-2xl font-bold mt-1 text-green-400"><%= childSubdomains.length %> <span class="text-xs text-slate-400 font-normal">(Bebas / Unlimited)</span></div>
      </div>
      <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 flex items-center justify-between">
        <div>
          <div class="text-xs text-slate-400 font-semibold uppercase">Status Akaun</div>
          <div class="text-sm font-semibold text-blue-400 uppercase mt-1"><%= user.role %> - <%= user.package %></div>
        </div>
        <a href="/" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold px-3 py-2 rounded-lg transition">+ Tambah Utama</a>
      </div>
    </div>

    <!-- Senarai Subdomain Utama -->
    <div class="bg-slate-800 rounded-2xl border border-slate-700 p-6">
      <h2 class="text-lg font-bold mb-4 text-blue-300">Subdomain Utama Anda</h2>
      <% if (primarySubdomains.length === 0) { %>
        <p class="text-sm text-slate-500">Anda belum mempunyai subdomain utama.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-900/50 text-slate-400 uppercase text-xs">
              <tr>
                <th class="p-3">Subdomain</th>
                <th class="p-3">Jenis</th>
                <th class="p-3">Target</th>
                <th class="p-3 text-right">Tindakan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-700">
              <% primarySubdomains.forEach(sub => { %>
                <tr>
                  <td class="p-3 font-semibold text-white"><%= sub.full_domain %></td>
                  <td class="p-3"><span class="bg-slate-700 px-2 py-0.5 rounded text-xs"><%= sub.record_type %></span></td>
                  <td class="p-3 text-slate-300"><%= sub.target_value %></td>
                  <td class="p-3 text-right">
                    <form action="/subdomain/delete/<%= sub.id %>" method="POST" onsubmit="return confirm('Padam subdomain ini? Semua subdomain sekunder di bawahnya turut akan terpadam!');" class="inline">
                      <button class="text-xs bg-red-600 hover:bg-red-500 text-white px-2.5 py-1 rounded transition">Padam</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Form Cipta Subdomain Sekunder (Level 2) -->
    <% if (primarySubdomains.length > 0) { %>
      <div class="bg-slate-800 rounded-2xl border border-slate-700 p-6">
        <h2 class="text-lg font-bold mb-2 text-green-400">Cipta Subdomain Sekunder (Contoh: panel.pahri.fakrulafif.store)</h2>
        <p class="text-xs text-slate-400 mb-4">Anda boleh mencipta subdomain sekunder seberapa banyak yang anda mahu secara percuma.</p>

        <form action="/subdomain/create-child" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Pilih Subdomain Induk</label>
            <select name="parent_subdomain_id" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-green-500">
              <% primarySubdomains.forEach(p => { %>
                <option value="<%= p.id %>">.<%= p.full_domain %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Prefix Anak (cth: panel)</label>
            <input type="text" name="child_prefix" placeholder="panel" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-green-500">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Jenis DNS & Target IP</label>
            <div class="flex space-x-2">
              <select name="record_type" class="w-1/3 bg-slate-900 border border-slate-700 rounded-lg px-2 py-2 text-sm focus:outline-none focus:border-green-500">
                <option value="A">A</option>
                <option value="CNAME">CNAME</option>
              </select>
              <input type="text" name="target_value" placeholder="103.xxx.xxx.xxx" required class="w-2/3 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-green-500">
            </div>
          </div>
          <div class="flex items-end">
            <button type="submit" class="w-full bg-green-600 hover:bg-green-500 py-2.5 rounded-lg text-sm font-semibold transition">Cipta Anak Subdomain</button>
          </div>
        </form>

        <!-- Senarai Subdomain Sekunder -->
        <% if (childSubdomains.length > 0) { %>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-900/50 text-slate-400 uppercase text-xs">
                <tr>
                  <th class="p-3">Subdomain Sekunder</th>
                  <th class="p-3">Induk</th>
                  <th class="p-3">Jenis</th>
                  <th class="p-3">Target</th>
                  <th class="p-3 text-right">Tindakan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-700">
                <% childSubdomains.forEach(c => { %>
                  <tr>
                    <td class="p-3 font-semibold text-green-300"><%= c.full_domain %></td>
                    <td class="p-3 text-slate-400"><%= c.parent_domain %></td>
                    <td class="p-3"><span class="bg-slate-700 px-2 py-0.5 rounded text-xs"><%= c.record_type %></span></td>
                    <td class="p-3 text-slate-300"><%= c.target_value %></td>
                    <td class="p-3 text-right">
                      <form action="/subdomain/delete/<%= c.id %>" method="POST" onsubmit="return confirm('Padam subdomain sekunder ini?');" class="inline">
                        <button class="text-xs bg-red-600 hover:bg-red-500 text-white px-2.5 py-1 rounded transition">Padam</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</body>
</html>
